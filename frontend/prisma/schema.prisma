  userId              String   @id @map("user_id") @db.Uuid
  totpSecretEncrypted Bytes    @map("totp_secret_encrypted")
  recoveryCodeHashes  String[] @default([]) @map("recovery_code_hashes")
  enabledAt           DateTime @default(now()) @map("enabled_at") @db.Timestamptz(6)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_mfa")
}

model UserSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      AppRole
  collegeId String?   @map("college_id") @db.Uuid
  mfaPassed Boolean   @default(false) @map("mfa_passed")
  ip        String?   @db.Inet
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  college   College?  @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_sessions")
}

model User {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId               String                   @unique @default(dbgenerated("('USR-'::text || nextval('seq_user_public'::regclass))")) @map("public_id")
  universityId           String                   @map("university_id") @db.Uuid
  email                  String                   @unique @db.Citext
  fullName               String                   @map("full_name")
  status                 UserStatus               @default(Invited)
  mfaRequired            Boolean                  @default(true) @map("mfa_required")
  ssoOnly                Boolean                  @default(false) @map("sso_only")
  notes                  String?
  lastLoginAt            DateTime?                @map("last_login_at") @db.Timestamptz(6)
  version                Int                      @default(1)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  admissionStatusHistory AdmissionStatusHistory[]
  assignments            Assignment[]
  auditLog               AuditLog[]
  boosterStepCompletions BoosterStepCompletion[]
  classSummaries         ClassSummary[]
  assignedEvaluations    EvaluationItem[]         @relation("EvaluationAssignee")
  reviewedEvaluations    EvaluationItem[]         @relation("EvaluationReviewer")
  evaluationOverrides    EvaluationOverride[]
  facultyActivityEvents  FacultyActivityEvent[]
  learningCourses        LearningCourse[]
  lessonOutlines         LessonOutline[]
  mediaAssets            MediaAsset[]
  notifications          Notification[]
  quizzes                Quiz[]
  grantedRoles           RoleAssignment[]         @relation("RoleGrantor")
  roleAssignments        RoleAssignment[]         @relation("RoleHolder")
  staff                  Staff?
  student                Student?
  userCredential         UserCredential?
  userMfa                UserMfa?
  userSessions           UserSession[]
  university             University               @relation(fields: [universityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("users")
}

/// Placement readiness per student (read-only). Weights: quizzes 35, certificates 20,
/// aptitude 15, mock interview 15, resume ATS 15. Defined in SQL (security_invoker, so RLS applies).
view PlacementReadiness {
  studentId    String  @unique @map("student_id") @db.Uuid
  collegeId    String  @map("college_id") @db.Uuid
  rollNo       String  @map("roll_no")
  name         String
  department   String
  quizAverage  Decimal @map("quiz_average") @db.Decimal
  certificates BigInt
  aptitude     Decimal @db.Decimal
  interview    Int
  resume       Int
  total        Int
  status       String

  @@map("v_placement_readiness")
}

