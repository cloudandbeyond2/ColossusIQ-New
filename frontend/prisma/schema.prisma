model QuestionBank {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId    String             @unique @default(dbgenerated("('Q-'::text || nextval('seq_question_public'::regclass))")) @map("public_id")
  collegeId   String             @map("college_id") @db.Uuid
  question    String
  topic       String
  difficulty  QuestionDifficulty @default(Medium)
  bloom       BloomLevel         @default(Understand)
  co          String
  marks       Int                @default(2) @db.SmallInt
  explanation String?            @default("")
  status      QuestionStatus     @default(Active)
  version     Int                @default(1)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  college     College            @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([collegeId, status], map: "idx_question_bank_college_status")
  @@index([collegeId, topic], map: "idx_question_bank_topic")
  @@index([collegeId, difficulty], map: "idx_question_bank_difficulty")
  @@map("question_bank")
}

