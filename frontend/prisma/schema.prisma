// ════════════════════════════════════════════════════════════════════════════════════════════
//  CollossusIQ — Prisma schema (PostgreSQL 15+)
//
//  The SQL migration is the source of truth: db/migrations/0001_init.sql
//  (copied to prisma/migrations/20260929000000_init/migration.sql as the Prisma baseline).
//  This file mirrors it for typed queries. Things Prisma cannot express live only in SQL:
//    • CHECK constraints (phone/code formats, ranges, JSON shapes, date order)
//    • triggers: updated_at/version bump, stream matching, quiz attempt limit,
//      admission status history, append-only audit tables
//    • row-level security (college isolation via app_set_context) and the ciq_app role
//    • DEFERRABLE position uniques (units, lessons, quiz questions) for reordering
//    • the v_placement_readiness view body
//  Change the schema in a new SQL migration first, then update this file to match
//  (`npx prisma db pull --print` shows the introspected shape) and run `npm run prisma:validate`.
//  Do not use `prisma migrate dev` to author changes — it cannot see the SQL-only objects above.
//
//  Every query must run inside a transaction that first calls
//    SELECT app_set_context($collegeId, 'college' | 'all', $userId)
//  otherwise RLS returns no rows for college-scoped tables.
// ════════════════════════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "views"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext]
}

model AdmissionDocument {
  admissionId String                @map("admission_id") @db.Uuid
  document    AdmissionDocumentType
  verifiedAt  DateTime              @default(now()) @map("verified_at") @db.Timestamptz(6)
  admission   Admission             @relation(fields: [admissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([admissionId, document])
  @@map("admission_documents")
}

model AdmissionStatusHistory {
  id            BigInt           @id @default(autoincrement())
  admissionId   String           @map("admission_id") @db.Uuid
  fromStatus    AdmissionStatus? @map("from_status")
  toStatus      AdmissionStatus  @map("to_status")
  changedBy     String?          @map("changed_by") @db.Uuid
  changedAt     DateTime         @default(now()) @map("changed_at") @db.Timestamptz(6)
  admission     Admission        @relation(fields: [admissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changedByUser User?            @relation(fields: [changedBy], references: [id], onUpdate: NoAction)

  @@index([admissionId, changedAt])
  @@map("admission_status_history")
}

model Admission {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId               String                   @unique @default(dbgenerated("((('ADM-'::text || to_char(now(), 'YY'::text)) || '-'::text) || nextval('seq_admission_public'::regclass))")) @map("public_id")
  collegeId              String                   @map("college_id") @db.Uuid
  fullName               String                   @map("full_name")
  dob                    DateTime                 @db.Date
  gender                 Gender
  email                  String                   @db.Citext
  phone                  String
  city                   String?
  state                  HomeState                @default(Tamil_Nadu)
  board                  SchoolBoard
  hscPercent             Decimal                  @map("hsc_percent") @db.Decimal(5, 2)
  entranceScore          Decimal?                 @map("entrance_score") @db.Decimal(6, 2)
  programmeId            Int                      @map("programme_id")
  quota                  AdmissionQuota
  category               ReservationCategory
  scholarship            Boolean                  @default(false)
  hostel                 Boolean                  @default(false)
  guardianName           String                   @map("guardian_name")
  guardianPhone          String                   @map("guardian_phone")
  guardianOccupation     String?                  @map("guardian_occupation")
  status                 AdmissionStatus          @default(Enquiry)
  source                 String                   @default("office")
  notes                  String?
  version                Int                      @default(1)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  admissionDocuments     AdmissionDocument[]
  admissionStatusHistory AdmissionStatusHistory[]
  college                College                  @relation(fields: [collegeId], references: [id], onUpdate: NoAction)
  programme              Programme                @relation(fields: [programmeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student                Student?

  @@index([collegeId, createdAt(sort: Desc)])
  @@index([collegeId, status])
  @@map("admissions")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now()) @db.Timestamptz(6)
  collegeId   String?  @map("college_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorName   String   @map("actor_name")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  ip          String?  @db.Inet
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onUpdate: NoAction)
  college     College? @relation(fields: [collegeId], references: [id], onUpdate: NoAction)

  @@index([collegeId, at(sort: Desc)])
  @@map("audit_log")
}

model BoosterStepCompletion {
  userId      String   @map("user_id") @db.Uuid
  track       String
  step        String
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, track, step])
  @@map("booster_step_completions")
}

model Certificate {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId       String           @unique @default(dbgenerated("((('CIQ-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || upper(encode(gen_random_bytes(4), 'hex'::text)))")) @map("public_id")
  kind           CertificateKind
  quizId         String           @map("quiz_id") @db.Uuid
  attemptId      String           @unique @map("attempt_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  collegeId      String           @map("college_id") @db.Uuid
  studentName    String           @map("student_name")
  title          String
  course         String
  departmentName String           @map("department_name")
  marks          Int              @db.SmallInt
  total          Int              @db.SmallInt
  percentage     Decimal          @db.Decimal(5, 2)
  grade          CertificateGrade
  gradeLabel     String           @map("grade_label")
  issuedAt       DateTime         @default(now()) @map("issued_at") @db.Timestamptz(6)
  signature      String
  supersededAt   DateTime?        @map("superseded_at") @db.Timestamptz(6)
  supersededById String?          @map("superseded_by_id") @db.Uuid
  attempt        QuizAttempt      @relation(fields: [attemptId], references: [id], onUpdate: NoAction)
  college        College          @relation(fields: [collegeId], references: [id], onUpdate: NoAction)
  quiz           Quiz             @relation(fields: [quizId], references: [id], onUpdate: NoAction)
  student        Student          @relation(fields: [studentId], references: [id], onUpdate: NoAction)
  supersededBy   Certificate?     @relation("CertificateSupersession", fields: [supersededById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersedes     Certificate[]    @relation("CertificateSupersession")

  @@index([collegeId, issuedAt(sort: Desc)])
  @@map("certificates")
}

model ClassSummary {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId          String             @unique @default(dbgenerated("hex_id('CS-'::text)")) @map("public_id")
  collegeId         String             @map("college_id") @db.Uuid
  authorId          String?            @map("author_id") @db.Uuid
  authorName        String             @map("author_name")
  departmentId      Int                @map("department_id")
  courseTitle       String?            @map("course_title")
  topic             String
  title             String
  classDate         DateTime           @map("class_date") @db.Date
  points            Json
  homework          String             @default("")
  nextClass         String             @default("") @map("next_class")
  resources         Json               @default("[]")
  infographic       Json?
  sharedAt          DateTime           @default(now()) @map("shared_at") @db.Timestamptz(6)
  withdrawnAt       DateTime?          @map("withdrawn_at") @db.Timestamptz(6)
  author            User?              @relation(fields: [authorId], references: [id], onUpdate: NoAction)
  college           College            @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department        Department         @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classSummaryReads ClassSummaryRead[]

  @@map("class_summaries")
}

model ClassSummaryRead {
  summaryId String       @map("summary_id") @db.Uuid
  studentId String       @map("student_id") @db.Uuid
  readAt    DateTime     @default(now()) @map("read_at") @db.Timestamptz(6)
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  summary   ClassSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([summaryId, studentId])
  @@map("class_summary_reads")
}

model ClinicalRotation {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId           String             @unique @default(dbgenerated("('ROT-'::text || nextval('seq_rotation_public'::regclass))")) @map("public_id")
  collegeId          String             @map("college_id") @db.Uuid
  studentId          String?            @map("student_id") @db.Uuid
  studentName        String             @map("student_name")
  regNo              String             @map("reg_no")
  phase              RotationPhase
  department         ClinicalDepartment
  unit               String
  startDate          DateTime           @map("start_date") @db.Date
  endDate            DateTime           @map("end_date") @db.Date
  supervisorStaffId  String?            @map("supervisor_staff_id") @db.Uuid
  supervisorName     String             @map("supervisor_name")
  attendance         Int?               @db.SmallInt
  competenciesSigned Int?               @map("competencies_signed") @db.SmallInt
  status             RotationStatus     @default(Scheduled)
  remarks            String?
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  college            College            @relation(fields: [collegeId], references: [id], onUpdate: NoAction)
  student            Student?           @relation(fields: [studentId], references: [id], onUpdate: NoAction)
  supervisorStaff    Staff?             @relation(fields: [supervisorStaffId], references: [id], onUpdate: NoAction)

  @@index([collegeId, startDate])
  @@map("clinical_rotations")
}

model CollegeDepartment {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId     String           @unique @default(dbgenerated("('DEP-'::text || nextval('seq_department_public'::regclass))")) @map("public_id")
  collegeId    String           @map("college_id") @db.Uuid
  departmentId Int              @map("department_id")
  headName     String?          @map("head_name")
  established  Int?             @db.SmallInt
  status       DepartmentStatus @default(Active)
  email        String?          @db.Citext
  phone        String?
  notes        String?
  version      Int              @default(1)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  college      College          @relation(fields: [collegeId], references: [id], onUpdate: NoAction)
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([collegeId, departmentId])
  @@index([collegeId, status])
  @@map("college_departments")
}

model CollegeModule {
  collegeId String      @map("college_id") @db.Uuid
  module    ModuleGroup
  college   College     @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([collegeId, module])
  @@map("college_modules")
}

model CollegeType {
  name      String    @id
  streamKey String    @map("stream_key")
  stream    Stream    @relation(fields: [streamKey], references: [key], onDelete: NoAction, onUpdate: NoAction)
  colleges  College[]

  @@map("college_types")
}

model CollegeWebsite {
  collegeId        String      @id @map("college_id") @db.Uuid
  tagline          String
  heroMediaId      String?     @map("hero_media_id") @db.Uuid
  heroBuiltin      String?     @map("hero_builtin")
  announcement     String?
  about            String
  principalMessage String?     @map("principal_message")
  highlights       String?
  address          String
  phone            String
  email            String      @db.Citext
  officeHours      String?     @map("office_hours")
  showEvents       Boolean     @default(true) @map("show_events")
  showGallery      Boolean     @default(true) @map("show_gallery")
  version          Int         @default(1)
  updatedAt        DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  college          College     @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  heroMedia        MediaAsset? @relation(fields: [heroMediaId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("college_websites")
}

model College {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId              String                 @unique @default(dbgenerated("('COL-'::text || nextval('seq_college_public'::regclass))")) @map("public_id")
  universityId          String                 @map("university_id") @db.Uuid
  name                  String
  code                  String                 @db.Char(4)
  type                  String
  city                  String
  established           Int?                   @db.SmallInt
  studentCapacity       Int                    @map("student_capacity")
  principal             String
  email                 String                 @db.Citext
  phone                 String
  plan                  CollegePlan            @default(Campus_Pro)
  status                CollegeStatus          @default(Onboarding)
  admissionsOpen        Boolean                @default(true) @map("admissions_open")
  version               Int                    @default(1)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  admissions            Admission[]
  auditLog              AuditLog[]
  assignments           Assignment[]
  knowledgeDocuments    KnowledgeDocument[]
  knowledgeChunks       KnowledgeChunk[]
  certificates          Certificate[]
  classSummaries        ClassSummary[]
  clinicalRotations     ClinicalRotation[]
  collegeDepartments    CollegeDepartment[]
  collegeModules        CollegeModule[]
  collegeWebsite        CollegeWebsite?
  collegeType           CollegeType            @relation(fields: [type], references: [name], onDelete: NoAction, onUpdate: NoAction)
  university            University             @relation(fields: [universityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courses               Course[]
  evaluationItems       EvaluationItem[]
  events                Event[]
  facultyActivityEvents FacultyActivityEvent[]
  galleryItems          GalleryItem[]
  interviewSessions     InterviewSession[]
  learningCourses       LearningCourse[]
  lessonOutlines        LessonOutline[]
  mediaAssets           MediaAsset[]
  notifications         Notification[]
  quizAttempts          QuizAttempt[]
  quizzes               Quiz[]
  resumeAnalyses        ResumeAnalysis[]
  roleAssignments       RoleAssignment[]
  staff                 Staff[]
  students              Student[]
  userSessions          UserSession[]
  questionBank          QuestionBank[]
  studyPlans            StudyPlan[]
  studentStates         StudentState[]
  assignmentSubmissions AssignmentSubmission[]
  studentExperiences    StudentExperience[]

  @@unique([universityId, code])
  @@unique([universityId, name])
  @@map("colleges")
}

model CourseOutcome {
  courseId String         @map("course_id") @db.Uuid
  code     String
  bloom    BloomLevel
  text     String
  course   LearningCourse @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([courseId, code])
  @@map("course_outcomes")
}

model CourseUnit {
  id       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId String         @map("course_id") @db.Uuid
  position Int            @db.SmallInt
  title    String
  part     String?
  course   LearningCourse @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lessons  Lesson[]

  @@unique([courseId, position])
  @@map("course_units")
}

model Course {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId       String          @unique @default(dbgenerated("('CRS-'::text || nextval('seq_course_public'::regclass))")) @map("public_id")
  collegeId      String          @map("college_id") @db.Uuid
  code           String
  title          String
  departmentId   Int             @map("department_id")
  termId         Int             @map("term_id")
  credits        Int             @db.SmallInt
  courseType     CourseType      @map("course_type")
  facultyStaffId String?         @map("faculty_staff_id") @db.Uuid
  facultyName    String          @map("faculty_name")
  status         CourseStatus    @default(Draft)
  description    String?
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  college        College         @relation(fields: [collegeId], references: [id], onUpdate: NoAction)
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  facultyStaff   Staff?          @relation(fields: [facultyStaffId], references: [id], onUpdate: NoAction)
  term           Term            @relation(fields: [termId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  learningCourse LearningCourse?

  @@unique([collegeId, code])
  @@map("courses")
}

model Department {
  id                 Int                 @id @default(autoincrement())
  streamKey          String              @map("stream_key")
  name               String
  classSummaries     ClassSummary[]
  collegeDepartments CollegeDepartment[]
  courses            Course[]
  stream             Stream              @relation(fields: [streamKey], references: [key], onDelete: NoAction, onUpdate: NoAction)
  learningCourses    LearningCourse[]
  quizzes            Quiz[]
  roleAssignments    RoleAssignment[]
  staff              Staff[]
  students           Student[]

  @@unique([streamKey, name])
  @@map("departments")
}

model Designation {
  id        Int     @id @default(autoincrement())
  streamKey String? @map("stream_key")
  name      String
  stream    Stream? @relation(fields: [streamKey], references: [key], onDelete: NoAction, onUpdate: NoAction)
  staff     Staff[]

  @@unique([streamKey, name])
  @@map("designations")
}

model EvaluationItem {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId           String               @map("college_id") @db.Uuid
  studentId           String               @map("student_id") @db.Uuid
  assignedTo          String?              @map("assigned_to") @db.Uuid
  assessment          String
  question            String
  answer              String
  aiResult            Json                 @map("ai_result")
  aiScore             Decimal              @map("ai_score") @db.Decimal(5, 2)
  maxScore            Decimal              @map("max_score") @db.Decimal(5, 2)
  confidence          Decimal              @db.Decimal(3, 2)
  status              EvaluationStatus     @default(pending)
  finalScore          Decimal?             @map("final_score") @db.Decimal(5, 2)
  reviewedBy          String?              @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  assignee            User?                @relation("EvaluationAssignee", fields: [assignedTo], references: [id], onUpdate: NoAction)
  college             College              @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewer            User?                @relation("EvaluationReviewer", fields: [reviewedBy], references: [id], onUpdate: NoAction)
  student             Student              @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  evaluationOverrides EvaluationOverride[]

  @@index([assignedTo, status])
  @@map("evaluation_items")
}

model EvaluationOverride {
  id               BigInt         @id @default(autoincrement())
  itemId           String         @map("item_id") @db.Uuid
  overriddenBy     String?        @map("overridden_by") @db.Uuid
  previousScore    Decimal?       @map("previous_score") @db.Decimal(5, 2)
  finalScore       Decimal        @map("final_score") @db.Decimal(5, 2)
  reason           String
  at               DateTime       @default(now()) @db.Timestamptz(6)
  item             EvaluationItem @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  overriddenByUser User?          @relation(fields: [overriddenBy], references: [id], onUpdate: NoAction)

  @@map("evaluation_overrides")
}

model EventRegistration {
  eventId      String   @map("event_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  registeredAt DateTime @default(now()) @map("registered_at") @db.Timestamptz(6)
  attended     Boolean?
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([eventId, studentId])
  @@map("event_registrations")
}

model Event {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId           String              @unique @default(dbgenerated("('EVT-'::text || nextval('seq_event_public'::regclass))")) @map("public_id")
  collegeId          String              @map("college_id") @db.Uuid
  title              String
  type               EventType
  eventDate          DateTime            @map("event_date") @db.Date
  startTime          DateTime            @map("start_time") @db.Time(6)
  venue              String
  organiser          String
  capacity           Int
  registrationOpen   Boolean             @default(true) @map("registration_open")
  status             EventStatus         @default(Draft)
  description        String?
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  eventRegistrations EventRegistration[]
  college            College             @relation(fields: [collegeId], references: [id], onUpdate: NoAction)

  @@index([collegeId, eventDate])
  @@map("events")
}

model FacultyActivityEvent {
  id        BigInt           @id @default(autoincrement())
  userId    String           @map("user_id") @db.Uuid
  collegeId String?          @map("college_id") @db.Uuid
  kind      FacultyEventKind
  at        DateTime         @default(now()) @db.Timestamptz(6)
  college   College?         @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, kind])
  @@map("faculty_activity_events")
}

model GalleryItem {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId     String          @unique @default(dbgenerated("('GAL-'::text || nextval('seq_gallery_public'::regclass))")) @map("public_id")
  collegeId    String          @map("college_id") @db.Uuid
  imageMediaId String?         @map("image_media_id") @db.Uuid
  imageBuiltin String?         @map("image_builtin")
  title        String
  category     GalleryCategory
  caption      String?
  featured     Boolean         @default(false)
  status       PublishStatus   @default(Draft)
  version      Int             @default(1)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  college      College         @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  imageMedia   MediaAsset?     @relation(fields: [imageMediaId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([collegeId, status])
  @@map("gallery_items")
}

model InterviewSession {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId    String        @map("student_id") @db.Uuid
  collegeId    String        @map("college_id") @db.Uuid
  mode         InterviewMode
  startedAt    DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime?     @map("completed_at") @db.Timestamptz(6)
  overallScore Int?          @map("overall_score") @db.SmallInt
  scorecard    Json?
  turns        Json          @default("[]")
  college      College       @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
