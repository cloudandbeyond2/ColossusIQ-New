  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, key])
  @@index([collegeId])
  @@map("student_state")
}
