# ════════════════════════════════════════════════════════════════════════════════════════════
#  ColossusIQ — environment settings
#  Copy to .env.local (development) or set these in your hosting provider (production).
#  Never commit real values. Full guide: docs/SETUP.md
#
#  Integrations (storage, email, WhatsApp, SMS, payments, SSO, online classes, ERP webhook) and AI providers can
#  also be configured by the University Super Admin in the app (Platform → Integrations & Setup / AI Providers).
#  Settings saved in the app take precedence; the variables below are the fallback, field by field.
# ════════════════════════════════════════════════════════════════════════════════════════════

# ── Core (required) ──────────────────────────────────────────────────────────────────────────
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# 32+ random characters. Encrypts MFA secrets, AI keys and integration secrets at rest.
MFA_ENCRYPTION_KEY=
# The public address of this site (used in certificate QR codes and email links).
PUBLIC_APP_URL=http://localhost:3000

# ── Data ─────────────────────────────────────────────────────────────────────────────────────
# "memory" = demo data in the server's memory (resets on restart); "postgres" = PostgreSQL.
DATA_BACKEND=memory
# PostgreSQL connection string (DATA_BACKEND=postgres). Then run: npm run db:migrate
DATABASE_URL=
# Development only: password for the accounts created by `npm run db:dev-accounts`.
DEV_PASSWORD=
# "query" logs every SQL query (debugging only).
PRISMA_LOG=

# ── API mode ─────────────────────────────────────────────────────────────────────────────────
# "mock" serves /api/v1 from this app; "live" calls NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=

# ── AI providers (Platform → AI Providers) ───────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# "off" switches every AI feature to built-in templates.
COURSE_AI=

# ── Cloud storage (Integrations & Setup → Cloud storage) ─────────────────────────────────────
# database | s3 | s3-compatible | gcs | azure
STORAGE_PROVIDER=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
S3_PUBLIC_BASE_URL=
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_SERVICE_ACCOUNT_JSON=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_KEY=

# ── Email (Integrations & Setup → Email) ─────────────────────────────────────────────────────
# smtp | sendgrid | resend | ses
EMAIL_PROVIDER=
EMAIL_FROM_NAME=
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
# STARTTLS | SSL/TLS | None
SMTP_SECURITY=STARTTLS
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=
RESEND_API_KEY=
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# ── WhatsApp (Integrations & Setup → WhatsApp) ───────────────────────────────────────────────
# meta | twilio
WHATSAPP_PROVIDER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# en | ta | hi
WHATSAPP_LANGUAGE=en
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── SMS (Integrations & Setup → SMS) ─────────────────────────────────────────────────────────
# msg91 | twilio
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_ENTITY_ID=
TWILIO_SMS_FROM=

# ── Online payments (Integrations & Setup → Online payments) ─────────────────────────────────
# razorpay
PAYMENTS_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Single sign-on (Integrations & Setup → Single sign-on) ───────────────────────────────────
# google | microsoft
SSO_PROVIDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Online classes (Integrations & Setup → Online classes) ───────────────────────────────────
# zoom | jitsi
MEETINGS_PROVIDER=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
JITSI_BASE_URL=

# ── ERP / SIS webhook (Integrations & Setup → ERP / SIS webhook) ─────────────────────────────
# https
WEBHOOK_PROVIDER=
WEBHOOK_URL=
WEBHOOK_SECRET=
